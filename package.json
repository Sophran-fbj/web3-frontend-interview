    "@next/mdx": "16.3.6",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "flexsearch": "^0.8.212",
    "gray-matter": "^4.0.3",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
