DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web3_frontend_interview
# 配齐以下变量并完成数据库迁移后再启用；默认维持本地学习。
AUTH_ENABLED=false
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 仅用于本地或受控预览；正式站点只发布 review 与 verified 题目。
CONTENT_PREVIEW=false

# 正式构建和运行时均填写同一个 HTTPS 域名，用于 canonical、分享链接和站点地图。
SITE_URL=
